# ═══════════════════════════════════════════════════════════════════
# Veyron Backend — Environment Configuration
# Copy this file to .env and fill in your actual keys
# ═══════════════════════════════════════════════════════════════════

# ──── REQUIRED: AI Engine ────
# Gemini API key (get from https://aistudio.google.com/app/apikey)
# Required for CyberSaathi chatbot. Fallback response works without it.
GEMINI_API_KEY=your_gemini_api_key_here

# ──── SECURITY SCANNER APIS ────
# VirusTotal (get from https://www.virustotal.com → API Key section)
# Used by Link Scanner for malware/phishing detection
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing (get from https://console.cloud.google.com/)
# Used by Link Scanner for phishing/malware detection
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here

# HIBP — Have I Been Pwned (get from https://haveibeenpwned.com/API/Key)
# Optional — Email Breach Checker uses XposedOrNot as fallback
HIBP_API_KEY=your_hibp_api_key_here

# ──── OPTIONAL: Firebase Persistence ────
# Leave empty if not using Firebase (data stored in-memory)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# ──── CORS & SECURITY ────
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173,http://localhost:5174
# Production: https://your-domain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5174

# Optional: API key for expensive endpoints (chat, scan-link, detect-deepfake)
# If set, these endpoints require x-api-key header
BACKEND_API_KEY=

# ──── APP CONFIGURATION ────
# Environment: development | staging | production
# Controls log verbosity and security behavior
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
# Auto-set to WARNING in production if not specified
LOG_LEVEL=DEBUG

# Rate limit per minute (global)
RATE_LIMIT_PER_MINUTE=100

# Deepfake debug images are disabled by default.
# Set to true only for local debugging; do not enable in production.
VEYRON_DEBUG_FACES=false

# Server port
PORT=8000
